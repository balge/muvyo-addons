{
  "api": 1,
  "id": "balge.woniu",
  "name": "蜗牛 4K",
  "version": "1.0.0",
  "author": "balge",
  "description": "搜索蜗牛 4K的 115 分享与磁力链接。",
  "min_mv_version": "3.14.0",
  "entry": "main.js",
  "permissions": {
    "domains": ["www.wn4k.com"]
  },
  "config": [
    {"key": "username", "label": "登录账号", "type": "text", "required": true},
    {"key": "password", "label": "密码", "type": "secret", "required": true},
    {"key": "result_limit", "label": "每次获取数量", "type": "number", "min": 1, "max": 20, "step": 1, "unit": "条", "default": "5"},
    {
      "key": "resource_types",
      "label": "资源类型",
      "type": "select",
      "default": "both",
      "options": [
        {"value": "both", "label": "115 和磁力"},
        {"value": "115", "label": "115 分享"},
        {"value": "magnet", "label": "磁力链接"}
      ]
    }
  ],
  "capabilities": {
    "search": {
      "link_types": ["115", "magnet"],
      "supports_tmdb": false,
      "resolve": true,
      "resolve_cost": "none"
    }
  }
}
